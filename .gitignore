# Godot 4+ specific ignores
.godot/
/android/

# .NET build output
bin/
obj/
*.user
.vs/
.idea/
TestResults/

# Local tooling / outputs
/out/
.godot_mcp/

# Third-party packs: originals and the copies Godot imports are NOT versioned.
# Sources are documented in docs/vendor_sources.md; rebuild with scripts/setup_vendor.py.
/art/vendor_raw/
# vendor copies are regenerated by the script, but their Godot import settings (*.import) are versioned
/godot/assets/vendor/**
!/godot/assets/vendor/**/
!/godot/assets/vendor/**/*.import
# derived from vendor by Blender (scripts/setup_vendor.py --derive); import settings versioned
/godot/assets/characters/source/*
!/godot/assets/characters/source/*.import
# tree impostor atlases baked by Godot from vendor meshes (scripts/setup_vendor.py --derive); import settings versioned
/godot/assets/environment/impostors/*
!/godot/assets/environment/impostors/*.import

# Dev tooling addon (symlink to local godot-devpilot-mcp checkout)
/godot/addons/godot_devpilot_mcp

# Third-party Godot addons installed by scripts/setup_vendor.py (see docs/vendor_sources.md)
/godot/addons/terrain_3d/

# Python bytecode
__pycache__/
*.pyc
