<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure simulation core. MUST NOT reference GodotSharp (runs headless, testable). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ironvale.Sim</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ironvale.Sim.Tests" />
  </ItemGroup>
</Project>
