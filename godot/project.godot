; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ironvale"
config/description="Sociedade Autônoma — city builder de delegação (Marco 1)"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Ironvale"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_devpilot_mcp/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[importer_defaults]

texture={
"compress/high_quality": false,
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"process/size_limit": 1024
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2

[shader_globals]

ground_base={
"type": "color",
"value": Color(0.36862746, 0.4392157, 0.27058825, 1)
}
ground_light={
"type": "color",
"value": Color(0.5254902, 0.627451, 0.30980393, 1)
}
