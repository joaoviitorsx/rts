  "foodPerMemberPerDay": 0.3,
  "firewoodPerHouseholdPerWinterDay": 1.0,
  "homelessHeatPermille": 2000,
  "toolWearPerWorkDayPermille": 8,
  "toolFactorFloorPermille": 500,
  "hungryFactorPermille": 600,
  "coldFactorPermille": 700,
  "leaveAfterDeficitDays": 30,
  "subsistenceFoodCoverPermille": 500,
  "subsistenceFirewoodCoverPermille": 500,
  // Walking (Marco 2A.3): ticks to enter a cell. Roads are faster; crossing other buildings is a last resort.
  "ticksPerCellRoad": 2,
  "ticksPerCellOffroad": 3,
  "roadStonePerCell": 1,
  // Commute: workers walk home → work → home inside the 10-hour shift and only produce on site.
  // autoRehome: a family with a job moves to a free house that saves at least rehomeMinGainTicks one way.
  // commuteTicksPermille: commute time = walking ticks × this ‰ (walkers' tick scale is compressed with the day;
  // 70 ‰ ≈ 20 % of the shift for 20 cells off-road, ≈ 14 % on road).
  "commuteTicksPermille": 70,
  "autoRehome": 1,
  // Yard garden: each family with a house grows food for itself in its free time (not in winter).
  // Free hours = gardenFreeHours − round-trip commute; food = free hours × gardenFoodPerHour (only up to its need).
  "gardenFreeHours": 2,
  "gardenFoodPerHour": 0.15,
  "rehomeMinGainTicks": 12,
  "carrierLoadTicks": 4,
  "minPickup": 2,
  "harvestVariancePermille": 100,
  "deadlockWindowDays": 60,
  "policyLogMax": 200,
  // Construction (Marco 2A.1): materials are hauled to the site; work = buildDays × 1 household at 100%.
  // autoBuilders: families without a job help the nearest site that can progress (1 = on, 0 = off).
  "autoBuilders": 1,
  "maxBuildersPerSite": 3
}
